#!/usr/bin/env python3

from concurrent.futures import ThreadPoolExecutor
import glob
import json
import os
import re
import subprocess
import sys
from threading import Lock

outputMutex = Lock()

# Exclude config files that are not verifying from CI
EXCLUDE_CONFS = [
    "certora/conf/CER-15-Permit/CER-51-Permit-msg-sender.conf"
]

# The harnesses import the sources and libraries, so a change under these paths
# can change the outcome of every config.
RUN_ALL_PREFIXES = (
    'src/',
    'lib/',
    'certora/harness/',
    '.github/workflows/checkrules.yml',
    '.github/executables/checkAllSpecs',
)

def listConfigs() -> list[str]:
    """List all config files."""
    subdir_confs = glob.glob('certora/conf/**/*.conf', recursive=True)
    root_confs = glob.glob('certora/conf/*.conf', recursive=True)
    confs = subdir_confs + root_confs
    return [x for x in confs if x not in EXCLUDE_CONFS]

def loadSpecImports(spec: str) -> set[str]:
    """Load a spec and the specs it imports, transitively."""
    found = set()
    pending = [os.path.normpath(spec)]
    while pending:
        current = pending.pop()
        if current in found:
            continue
        found.add(current)
        with open(current) as f:
            imports = re.findall(r'^\s*import\s+"([^"]+\.spec)"', f.read(), re.MULTILINE)
        pending += [os.path.normpath(os.path.join(os.path.dirname(current), i)) for i in imports]
    return found

def loadConfigDependencies(filename: str) -> set[str]:
    """Load all files a config depends on."""
    try:
        conf = json.load(open(filename))
        specs = re.findall(r'certora/specs/.+\.spec', conf['verify'])
        imported = set().union(*(loadSpecImports(s) for s in specs))
        return set([filename, *imported, *conf['files']])
    except Exception as e:
        print(f'cannot load the dependencies of {filename}: {e}')
        return set()

def listChangedConfigs() -> list[str]:
    """List config files that the PR changes. Outside a PR, or when the diff
    fails, list all config files."""
    # The base commit from the triggering event, not the base branch's tip: a run
    # approved after the merge must still see the PR's changes.
    BASESHA = os.environ.get('BASE_SHA', '')
    if BASESHA != '':
        print('::group::Identifying changed configurations', flush=True)
        fetch = subprocess.run(['git', 'fetch', '--depth=1', 'origin', BASESHA])
        diff = subprocess.run(['git', '-P', 'diff', '--name-only', BASESHA, 'HEAD'], capture_output=True)
        if fetch.returncode != 0 or diff.returncode != 0:
            print('could not diff against the base commit, running all configs')
            print('::endgroup::')
            return listConfigs()
        changed = set(diff.stdout.decode().splitlines())
        if any(f.startswith(RUN_ALL_PREFIXES) for f in changed):
            changed = listConfigs()
            print(f'changed configs (all): {changed}')
            print('::endgroup::')
            return changed
        cfiles = { c: loadConfigDependencies(c) for c in listConfigs() }
        changed = [ c for c in cfiles if (not cfiles[c]) or (cfiles[c] & changed)]
        print(f'changed configs: {changed}')
        print('::endgroup::')
        return changed
    else:
        return listConfigs()

def runConf(filename):
    """Run the configuration in `filename` and return None if everything worked,
    or the CompletedProcess when there was some error."""
    print(f'Starting {filename}')
    try:
        # The commit sha fixes the CI at release version 7.0.2
        # from February 2024.
        res = subprocess.run(['certoraRun', '--server', 'production', '--wait_for_results', 'all', filename],
                             capture_output = True)
    except Exception as e:
        with outputMutex:
            print(f'Failed to run {filename}: {e}')
        return None

    setattr(res, 'filename', filename)
    with outputMutex:
        out = res.stdout.decode().strip()
        m = re.search('https://[a-z-]+\.certora\.com/output/[0-9a-zA-Z?=/]+', out)
        if m:
            runurl = m.group(0)
        else:
            runurl = 'run not available'
        print(f'::group::Results for {filename} ({runurl})')
        if res.stdout != b'':
            print(out)
        if res.stderr != b'':
            print(f'error output:')
            print(res.stderr.decode().strip())
        if res.returncode != 0:
            print(f'Failed with {res.returncode}')
            print(f'::endgroup::')
            return res
        print(f'::endgroup::')
        return None

with ThreadPoolExecutor(max_workers=10) as executor:
    results = executor.map(runConf, listChangedConfigs())

failed = [r for r in results if r is not None]

if failed:
    print('Some jobs failed:')
    for r in failed:
        print(f'\t{r.filename}')
    sys.exit(1)
sys.exit(0)
